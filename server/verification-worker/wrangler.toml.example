name = "skinscope-verification"
main = "worker.js"
compatibility_date = "2026-07-26"

kv_namespaces = [
  { binding = "VERIFY_CODES", id = "replace-with-cloudflare-kv-namespace-id" }
]

[vars]
APP_NAME = "SkinScope"
FROM_EMAIL = "SkinScope <verify@your-domain.com>"
ALLOWED_ORIGINS = "https://ilovepiton.github.io,http://127.0.0.1:8765"

# Add these with `wrangler secret put`:
# RESEND_API_KEY
# VERIFY_SECRET
